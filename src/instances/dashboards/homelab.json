{
  "title": "Homelab",
  "uid": "homelab",
  "tags": ["homelab"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "VM",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=\"homelab-node-exporter\"}, instance)", "refId": "A" },
        "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }, "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(traefik_service_requests_total, service)", "refId": "A" },
        "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }, "sort": 1
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Requests — World Map", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "geomap",
      "title": "Request Origins (by country, last 24h)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 16, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum by (country) (count_over_time({job=\"traefik-access\", country=~\".+\"} [$__range]))", "instant": true }],
      "options": {
        "view": { "id": "zero", "lat": 20, "lon": 0, "zoom": 1.5 },
        "basemap": { "type": "default", "name": "Basemap" },
        "layers": [
          {
            "type": "markers",
            "name": "By country",
            "location": { "mode": "lookup", "lookup": "country", "gazetteer": "public/gazetteer/countries.json" },
            "config": {
              "style": {
                "size": { "field": "Value", "min": 4, "max": 30 },
                "color": { "field": "Value", "fixed": "dark-red" },
                "opacity": 0.6
              }
            }
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Top Countries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 8, "x": 16, "y": 1 },
      "targets": [{ "refId": "A", "expr": "topk(20, sum by (country) (count_over_time({job=\"traefik-access\", country=~\".+\"} [$__range])))", "instant": true }],
      "transformations": [{ "id": "labelsToFields", "options": {} }],
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] }
    },

    { "type": "row", "title": "HTTP", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 } },
    {
      "type": "stat", "title": "Requests/sec", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [{ "refId": "A", "expr": "sum(rate(traefik_service_requests_total{service=~\"$service\"}[5m]))" }]
    },
    {
      "type": "stat", "title": "% 4xx", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(traefik_service_requests_total{service=~\"$service\",code=~\"4..\"}[5m])) / clamp_min(sum(rate(traefik_service_requests_total{service=~\"$service\"}[5m])),1)" }]
    },
    {
      "type": "stat", "title": "% 5xx", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(traefik_service_requests_total{service=~\"$service\",code=~\"5..\"}[5m])) / clamp_min(sum(rate(traefik_service_requests_total{service=~\"$service\"}[5m])),1)" }]
    },
    {
      "type": "stat", "title": "VMs Up", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"homelab-node-exporter\"} == 1)" }]
    },
    {
      "type": "timeseries", "title": "Requests/sec by Status Code", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 30, "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (code) (rate(traefik_service_requests_total{service=~\"$service\"}[5m]))", "legendFormat": "{{code}}" }]
    },
    {
      "type": "timeseries", "title": "Latency p50/p90/p99", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.90, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p90" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p99" }
      ]
    },

    { "type": "row", "title": "System (by VM)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 } },
    {
      "type": "timeseries", "title": "CPU busy %", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [{ "refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)", "legendFormat": "{{instance}}" }]
    },
    {
      "type": "timeseries", "title": "Memory used %", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [{ "refId": "A", "expr": "100 * (1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}))", "legendFormat": "{{instance}}" }]
    },
    {
      "type": "timeseries", "title": "Disk used % (root)", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [{ "refId": "A", "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",instance=~\"$instance\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=~\"$instance\"}))", "legendFormat": "{{instance}}" }]
    },
    {
      "type": "timeseries", "title": "Network I/O", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!=\"lo\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} rx" },
        { "refId": "B", "expr": "-sum by (instance) (rate(node_network_transmit_bytes_total{device!=\"lo\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} tx" }
      ]
    },

    { "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 } },
    {
      "type": "timeseries", "title": "Error/Warning log rate by host", "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "fieldConfig": { "defaults": { "unit": "logs/s", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (host) (rate({job=\"systemd-journal\", level=~\"err|warning|crit|alert|emerg\"} [5m]))", "legendFormat": "{{host}}" }]
    },
    {
      "type": "logs", "title": "Recent errors", "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 51 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{job=\"systemd-journal\", level=~\"err|crit|alert|emerg\"}" }]
    }
  ]
}
