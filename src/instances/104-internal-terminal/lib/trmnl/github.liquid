{%- comment -%} github panel, data from github-sync.py; keep flat {%- endcomment -%}

<style>
/* undo trmnl's centring wrapper; the framework keeps the height, and it is the size container */
.layout { display: block !important; width: 100% !important; padding: 0 !important; margin: 0 !important; container-type: size; }
/* --u: 1px on the 780x460 og layout, the smaller ratio on bigger panels */
.gh { --u: min(calc(100cqw / 780), calc(100cqh / 460)); display: flex; flex-direction: column; height: 100%; width: 100%; gap: calc(5 * var(--u)); padding: calc(6 * var(--u)) calc(8 * var(--u)) calc(2 * var(--u)); box-sizing: border-box; font-family: "Inter Variable", Inter, sans-serif; color: #000; }

/* ---- headline numbers ------------------------------------------------- */
.gh-top { display: flex; gap: calc(6 * var(--u)); flex: 0 0 auto; }
.gh-stat { flex: 1 1 0; border: calc(2 * var(--u)) solid #000; border-radius: calc(4 * var(--u)); padding: calc(3 * var(--u)) calc(8 * var(--u)) calc(4 * var(--u)); min-width: 0; }
.gh-stat--bad { background: #000; color: #fff; }
.gh-k { font-size: calc(11 * var(--u)); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
.gh-v { font-size: calc(30 * var(--u)); font-weight: 800; line-height: 1.05; font-variant-numeric: tabular-nums; }
.gh-sub { font-size: calc(12 * var(--u)); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---- body: repos wide, CI and work narrow ------------------------------ */
.gh-mid { display: flex; gap: calc(6 * var(--u)); flex: 1 1 auto; min-height: 0; }
.gh-box { border: calc(2 * var(--u)) solid #000; border-radius: calc(4 * var(--u)); padding: calc(3 * var(--u)) calc(8 * var(--u)); display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
/* repos have the volume, so they get width */
.gh-repos { flex: 1.3 1 0; }
.gh-side { flex: 1 1 0; display: flex; flex-direction: column; gap: calc(5 * var(--u)); min-width: 0; min-height: 0; }
.gh-ci, .gh-work { flex: 0 0 auto; }
/* languages take what ci and work leave */
.gh-lang { flex: 1 1 auto; }
.gh-cols { display: flex; gap: calc(14 * var(--u)); min-height: 0; overflow: hidden; flex: 1 1 auto; }
.gh-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }

.gh-h { font-size: calc(11 * var(--u)); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; border-bottom: calc(2 * var(--u)) solid #000; margin-bottom: calc(2 * var(--u)); padding-bottom: calc(1 * var(--u)); display: flex; justify-content: space-between; gap: calc(6 * var(--u)); white-space: nowrap; flex: 0 0 auto; }
.gh-h i { font-style: normal; font-weight: 500; letter-spacing: 0; text-transform: none; }

.gh-l { display: flex; align-items: center; gap: calc(6 * var(--u)); font-size: calc(13.5 * var(--u)); font-weight: 500; line-height: 1.35; flex: 0 0 auto; min-width: 0; }
.gh-dot { width: calc(9 * var(--u)); height: calc(9 * var(--u)); flex: 0 0 auto; border: calc(1.5 * var(--u)) solid #000; border-radius: 50%; background: #fff; box-sizing: border-box; }
.gh-dot--ok { background: #000; }
.gh-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gh-meta { flex: 0 0 auto; font-size: calc(11.5 * var(--u)); font-variant-numeric: tabular-nums; }
.gh-n { flex: 0 0 auto; font-weight: 800; font-variant-numeric: tabular-nums; }
/* star count reads as a badge, not another number */
.gh-star { flex: 0 0 auto; font-size: calc(11 * var(--u)); font-weight: 800; border: calc(1.5 * var(--u)) solid #000; border-radius: calc(3 * var(--u)); padding: 0 calc(3 * var(--u)); line-height: 1.2; }
.gh-bar { flex: 0 0 calc(70 * var(--u)); height: calc(8 * var(--u)); border: calc(1.5 * var(--u)) solid #000; box-sizing: border-box; }
.gh-bar span { display: block; height: 100%; background: #000; }

/* say empty, else it reads as broken */
.gh-none { font-size: calc(13 * var(--u)); font-weight: 500; padding: calc(2 * var(--u)) 0; }

.gh-foot { flex: 0 0 auto; display: flex; justify-content: space-between; align-items: center; font-size: calc(11 * var(--u)); line-height: 1.25; white-space: nowrap; }
.gh-foot b { letter-spacing: .08em; text-transform: uppercase; }
</style>

<div class="layout">
<div class="gh">

<div class="gh-top">
<div class="gh-stat">
<div class="gh-k">Commits 7d</div>
<div class="gh-v">{{ commits7 | escape }}</div>
<div class="gh-sub">{{ commits30 | escape }} in 30d</div>
</div>
<div class="gh-stat">
<div class="gh-k">Repos</div>
<div class="gh-v">{{ repos | escape }}</div>
<div class="gh-sub">{{ stars | escape }} stars</div>
</div>
<div class="gh-stat{% if ci_failing > 0 %} gh-stat--bad{% endif %}">
<div class="gh-k">CI failing</div>
<div class="gh-v">{{ ci_failing | escape }}</div>
<div class="gh-sub">{{ ci_runs | escape }} runs</div>
</div>
<div class="gh-stat">
<div class="gh-k">Open</div>
<div class="gh-v">{{ issues | escape }}/{{ prs | escape }}</div>
<div class="gh-sub">issues / PRs</div>
</div>
<div class="gh-stat{% if alerts > 0 %} gh-stat--bad{% endif %}">
<div class="gh-k">Alerts</div>
<div class="gh-v">{{ alerts | escape }}</div>
<div class="gh-sub">security</div>
</div>
</div>

<div class="gh-mid">

<div class="gh-box gh-repos">
<div class="gh-h"><span>Recently pushed</span><i>language &middot; stars &middot; ago</i></div>
<div class="gh-cols">
<div class="gh-col">
{%- for r in active_a %}
<div class="gh-l"><span class="gh-name">{{ r.name | escape }}</span><span class="gh-meta">{{ r.lang | escape }}</span>{%- if r.stars > 0 %}<span class="gh-star">{{ r.stars | escape }}</span>{%- endif %}<span class="gh-meta">{{ r.age | escape }}</span></div>
{%- endfor %}
</div>
<div class="gh-col">
{%- for r in active_b %}
<div class="gh-l"><span class="gh-name">{{ r.name | escape }}</span><span class="gh-meta">{{ r.lang | escape }}</span>{%- if r.stars > 0 %}<span class="gh-star">{{ r.stars | escape }}</span>{%- endif %}<span class="gh-meta">{{ r.age | escape }}</span></div>
{%- endfor %}
</div>
</div>
</div>

<div class="gh-side">
<div class="gh-box gh-ci">
<div class="gh-h"><span>Failing CI</span><i>runs &middot; last</i></div>
{%- if ci_failing == 0 %}
<div class="gh-none">every workflow green</div>
{%- endif %}
{%- for c in ci %}
<div class="gh-l"><span class="gh-dot"></span><span class="gh-name">{{ c.name | escape }}</span><span class="gh-meta">{{ c.what | escape }}</span><span class="gh-n">{{ c.n | escape }}</span><span class="gh-meta">{{ c.age | escape }}</span></div>
{%- endfor %}
</div>

<div class="gh-box gh-work">
<div class="gh-h"><span>Issues &amp; PRs</span><i>filled = PR</i></div>
{%- if work_empty %}
<div class="gh-none">nothing open</div>
{%- endif %}
{%- for w in work %}
<div class="gh-l"><span class="gh-dot{% if w.kind == 'pr' %} gh-dot--ok{% endif %}"></span><span class="gh-name">{{ w.title | escape }}</span><span class="gh-meta">{{ w.repo | escape }}</span><span class="gh-meta">{{ w.age | escape }}</span></div>
{%- endfor %}
</div>

<div class="gh-box gh-lang">
<div class="gh-h"><span>Languages</span><i>repos</i></div>
{%- for l in langs %}
<div class="gh-l"><span class="gh-name">{{ l.name | escape }}</span><span class="gh-bar"><span style="width:{{ l.pct | escape }}%"></span></span><span class="gh-n">{{ l.n | escape }}</span></div>
{%- endfor %}
</div>
</div>

</div>

<div class="gh-foot">
<span><b>GitHub</b> &middot; github.com/{{ user | escape }}</span>
<span>{{ generated | escape }}</span>
</div>

</div>
</div>
