#!/usr/bin/env -S nu --no-config-file
# converge the repo's sops files to the lab's secrets layout (modules/secrets.nix)
#
# The layout's plan says which file holds each declared secret and which hosts read each file; this makes the files
# say the same: every host has a key in its home (age.pub, and age.sops for the admins), .sops.yaml has one rule per
# file (the admins of src/secrets/admins.txt plus its readers), every declared secret has a value in its file
# (generated by its kind, src/secrets/shared.nix, or empty for a human; moved when found elsewhere), every host reading
# shared secrets gets its part of src/secrets/shared.sops.json, and src/generated/onions.json maps every onion secret
# to its address. A secret of kind dotfiles:<file> follows that file of the dotfiles' secrets.
#
# A file is rewritten only when its content or recipients change: sops output is randomized, and rewriting unchanged
# files would churn the public history. A rewrite always encrypts afresh, under a new data key.
# Rejected: `sops updatekeys`, which re-wraps the file's old data key; whoever held a removed admin key splices their
# stanza from the public history onto the new file and reads every later value. Removing an admin recipient also
# renews every host key: the removed key opens every age.sops in history, and with it every host key of the time.
#
# Every check runs before the first write, and every write is atomic (lib/secrets.nu). Writes go: rules, host keys,
# every values file with its new values added, the shared copies, then the removals, so a failed run leaves no file
# encrypted to a key that is not stored and no value without a copy, and a rerun converges.
#
# env: SOPS_AGE_KEY_FILE         the key that unlocks this run (default secrets/age.txt, the dotfiles key)
#      SECRETS_ADMIN_RECIPIENTS  space separated recipients in place of src/secrets/admins.txt (tests)
#      DOTFILES                  the dotfiles checkout (default ~/projects/arch-dotfiles)

const ROOT = path self | path dirname | path dirname | path dirname
const SRC = $ROOT | path join src
use lib/tools.nu [die run-text tools-require]
use lib/onion.nu [onion-seed-generate onion-address]
use lib/secrets.nu [
    secrets-admins-load secrets-plan-load secrets-encrypt secrets-age-key-lines secrets-age-recipient secrets-age-key-ready
    secrets-dotfiles-dir    SECRETS_HOME_DIRS SECRETS_CATALOG_FILE SECRETS_VALUES_NAME SECRETS_SHARED_NAME SECRETS_KEY_NAME SECRETS_PUB_NAME
]

# garage access key ids are GK plus 12 random bytes in hex
const GARAGE_KEY_ID_BYTES = 12
# a wireguard private key is 32 bytes; wireguard clamps any 32 bytes into a valid curve25519 scalar
const WIREGUARD_KEY_BYTES = 32
# laravel's APP_KEY (firefly): base64: and this many random bytes as base64, aes-256's key size
const LARAVEL_KEY_BYTES = 32
const GUARDED_PREFIX = "guardsData:"
const DOTFILES_PREFIX = "dotfiles:"
const ONIONS_FILE = "generated/onions.json"
const SOPS_CONFIG_HEADER = [
    "# generated by src/scripts/secrets-sync.nu from modules/secrets.nix, src/secrets/admins.txt and every age.pub"
    "#"
    "# Every file is encrypted to the admins and the hosts that read it: <home>/age.sops to the admins only,"
    "# <home>/secrets.sops.json and secrets.shared.sops.json to its host, an app's secrets.sops.json to its readers."
    "creation_rules:"
]

def src-path [file: string]: nothing -> path { $SRC | path join $file }

def recipients-of [file: path]: nothing -> list<string> {
    open --raw $file | from json | get --optional sops.age | default [] | get --optional recipient | default [] | sort
}

def decrypt [file: path]: nothing -> any {
    let plain = do { ^sops --decrypt $file } | complete
    if $plain.exit_code != 0 { null } else { $plain.stdout }
}

def key-generate []: nothing -> string {
    let generated = ^age-keygen e> /dev/null
    $generated | lines | where { str starts-with AGE-SECRET-KEY- } | first
}

# keys sorted at every depth, so two files that differ only in order compare equal
def canonical [value: any]: nothing -> any {
    match ($value | describe | str replace --regex '<.*' '') {
        "record" => { $value | transpose key value | sort-by key | reduce --fold {} {|e, acc| $acc | insert $e.key (canonical $e.value) } }
        "list" | "table" => { $value | each {|v| canonical $v } }
        _ => $value
    }
}

# a fresh value, or "" for a kind a human fills
def secret-generate [kind: string]: nothing -> string {
    let bare = $kind | str replace --regex $"^($GUARDED_PREFIX)" ""
    if ($bare | str starts-with "hex:") { return (run-text openssl rand -hex ($bare | str substring 4..)) }
    if ($bare | str starts-with $DOTFILES_PREFIX) { return "" }
    match $bare {
        "wireguard" => { run-text openssl rand -base64 ($WIREGUARD_KEY_BYTES | into string) }
        "laravel-key" => { $"base64:(run-text openssl rand -base64 ($LARAVEL_KEY_BYTES | into string))" }
        "garage-key-id" => { $"GK(run-text openssl rand -hex ($GARAGE_KEY_ID_BYTES | into string))" }
        "onion" => { onion-seed-generate }
        "manual" | "public" => { "" }
        _ => { die $"unknown kind ($kind)" }
    }
}

# every values file, declared or on disk, relative to src/
def value-files-find [plan: record]: nothing -> list<string> {
    let on_disk = $SECRETS_HOME_DIRS | each {|dir| glob (src-path $dir | path join "*" $SECRETS_VALUES_NAME) } | flatten
        | each { path relative-to $SRC }
    let catalog = if (src-path $SECRETS_CATALOG_FILE | path exists) { [$SECRETS_CATALOG_FILE] } else { [] }
    $plan.secrets | values | get file | append $catalog | append $on_disk | uniq | sort
}

def main [
    --apply                  # write; without it a dry run prints what would change
    --prune                  # delete the values of secrets nothing declares
    --generate-guarded       # generate missing guardsData secrets too: a first deploy (init.nu), or one declared new
    --plan: path             # the plan as json instead of evaluating the flake
    --host-keys-out: path    # with --apply, also write {"<configuration>": "<its age private key>"} there, mode 0600
]: nothing -> nothing {
    tools-require sops age-keygen openssl
    if $plan == null { tools-require nix }
    # the dotfiles key by default, linked and unlocked like sync.nu does; a key passed in is used as it is
    if ($env.SOPS_AGE_KEY_FILE? | is-empty) { secrets-age-key-ready ($ROOT | path join secrets age.txt) }

    # nothing is written before every check passes
    let admins = secrets-admins-load $SRC
    let admins_sorted = $admins | sort
    let layout = secrets-plan-load $SRC $plan
    let configs = $layout.hosts | columns | sort
    let home_of = {|c: string| $layout.hosts | get $c | get home }
    let in_plan = {|file: string| $file in ($layout.files | columns) }

    let old = value-files-find $layout | where { src-path $in | path exists } | reduce --fold {} {|file, acc|
        let plain = decrypt (src-path $file)
        if $plain == null { die $"src/($file) does not decrypt with ($env.SOPS_AGE_KEY_FILE)" }
        $acc | insert $file ($plain | from json | reject --optional sops)
    }

    # every host's key: the stored one, or a new one when it has none or an admin recipient it was encrypted to is gone
    let keys = $configs | reduce --fold {} {|c, acc|
        let home = do $home_of $c
        let key_file = src-path ($home | path join $SECRETS_KEY_NAME)
        let pub_file = src-path ($home | path join $SECRETS_PUB_NAME)
        let stored = if ($key_file | path exists) {
            let plain = decrypt $key_file
            if $plain == null { die $"src/($home)/($SECRETS_KEY_NAME) does not decrypt with ($env.SOPS_AGE_KEY_FILE)" }
            let key = $plain | str trim
            let pub = if ($pub_file | path exists) { open --raw $pub_file | str trim } else { "" }
            if $pub != (secrets-age-recipient $key) { die $"src/($home)/($SECRETS_PUB_NAME) is not the public half of its ($SECRETS_KEY_NAME)" }
            let gone = recipients-of $key_file | where $it not-in $admins_sorted
            {key: $key, state: (if ($gone | is-empty) { "kept" } else { "renewed" })}
        } else if ($pub_file | path exists) {
            die $"src/($home)/($SECRETS_PUB_NAME) has no ($SECRETS_KEY_NAME) beside it"
        } else {
            {key: "", state: "new"}
        }
        if $stored.state == "kept" { return ($acc | insert $c $stored.key) }
        print $"key     ($c): ($stored.state)"
        $acc | insert $c (key-generate)
    }
    let host_recipient = $keys | items {|c, key| {c: $c, r: (secrets-age-recipient $key)} } | reduce --fold {} {|e, acc| $acc | insert $e.c $e.r }

    let declared = $layout.secrets
    let kind_of = {|k: string| $declared | get $k | get kind }
    let file_of = {|k: string| $declared | get $k | get file }

    # each declared secret's value: from its own file, else from any other file holding it (a move)
    let located = $declared | items {|k, spec|
        let own = $old | get --optional $spec.file | default {}
        let found = if $k in ($own | columns) {
            {value: ($own | get $k)}
        } else {
            $old | items {|file, values| if $k in ($values | columns) { {value: ($values | get $k), from: $file} } } | compact | get --optional 0
        }
        {key: $k, found: $found}
    }
    for entry in ($located | where { $in.found?.from? != null }) {
        print $"move    ($entry.key): ($entry.found.from) -> (do $file_of $entry.key)"
    }
    # an empty guarded value is a missing one: a deploy must never hand it to what it guards
    let located = $located | each {|entry|
        let guarded = do $kind_of $entry.key | str starts-with $GUARDED_PREFIX
        if $guarded and $entry.found?.value? == "" { $entry | update found null } else { $entry }
    }
    # a fresh value for a guarded secret would lock out whatever the lost one protected
    let guarded_missing = $located | where { $in.found == null and (do $kind_of $in.key | str starts-with $GUARDED_PREFIX) }
    if ($guarded_missing | is-not-empty) and not $generate_guarded {
        die ([
            "these secrets guard data and have no value; a fresh one would lock the data out:"
            ...($guarded_missing | each { $"  ($in.key) in src/(do $file_of $in.key)" })
            "  Restore each one: sops set src/<file> '[\"<name>\"]' '\"<value>\"'. Only for one that guards nothing yet: --generate-guarded."
        ] | str join "\n")
    }
    let found = $located | reduce --fold {} {|entry, acc|
        if $entry.found != null { return ($acc | insert $entry.key $entry.found.value) }
        let kind = do $kind_of $entry.key
        let file = do $file_of $entry.key
        let value = secret-generate $kind
        if $value != "" {
            print $"add     ($entry.key) -> ($file) \(generated, ($kind)\)"
        } else {
            print $"add     ($entry.key) -> ($file) \(empty, fill it: sops src/($file)\)"
        }
        $acc | insert $entry.key $value
    }

    # kind dotfiles:<file>: the value lives in the dotfiles' secrets; the lab's copy follows it on every run
    let dotfiles_dir = secrets-dotfiles-dir
    let dotfiles_unlocked = (secrets-age-key-lines ($dotfiles_dir | path join age.txt) | is-not-empty)
    let found = $declared | items {|k, spec| {key: $k, spec: $spec} } | where { $in.spec.kind | str starts-with $DOTFILES_PREFIX }
        | reduce --fold $found {|entry, acc|
            let name = $entry.spec.kind | str substring ($DOTFILES_PREFIX | str length)..
            let source = $dotfiles_dir | path join $name
            if not $dotfiles_unlocked {
                print $"skip    ($entry.key): dotfiles secrets locked or absent, value kept"
                return $acc
            }
            let content = if ($source | path exists) { open --raw $source } else { "" }
            if $content == "" {
                print $"missing ($entry.key): put it in ($source), then re-run"
                return $acc
            }
            if ($acc | get $entry.key | str trim --right --char "\n") == ($content | str trim --right --char "\n") { return $acc }
            print $"copy    ($entry.key) <- dotfiles ($name) -> ($entry.spec.file)"
            $acc | upsert $entry.key ($content | str replace --regex '\n$' '')
        }

    for file in ($old | columns) {
        for k in ($old | get $file | columns | sort | where $it not-in ($declared | columns)) {
            if $prune {
                print $"remove  ($k) from ($file) \(nothing declares it\)"
            } else {
                print $"unused  ($k) in ($file) \(nothing declares it; --prune deletes it\)"
            }
        }
    }

    # the values every file ends with: declared ones where they are declared, undeclared ones kept unless pruned
    let kept = $old | items {|file, values|
        let undeclared = if $prune { {} } else { $values | reject --optional ...($declared | columns) }
        {file: $file, values: $undeclared}
    } | reduce --fold {} {|e, acc| $acc | insert $e.file $e.values }
    let new = $declared | items {|k, spec| {k: $k, file: $spec.file} } | reduce --fold $kept {|e, acc|
        $acc | upsert $e.file ($acc | get --optional $e.file | default {} | upsert $e.k ($found | get $e.k))
    }

    let shared_plain = {|c: string|
        let catalog = $new | get --optional $SECRETS_CATALOG_FILE | default {}
        $layout.hosts | get $c | get shared | sort | reduce --fold {} {|name, acc| $acc | insert $name ($catalog | get --optional $name) }
    }

    let rules = $layout.files | items {|file, readers|
        let recipients = $admins ++ ($readers | each {|c| $host_recipient | get $c })
        [$"  - path_regex: src/($file | str replace --all '.' '\.')$" $"    age: ($recipients | str join ',')"]
    } | flatten
    let sops_config = ($SOPS_CONFIG_HEADER ++ $rules | str join "\n") + "\n"

    # encrypted to the admins and the file's readers, when its content or recipients differ; true when it (would) write
    let write_file = {|file: string, plain: any|
        let path = src-path $file
        let want = $layout.files | get --optional $file | default [] | each {|c| $host_recipient | get $c } | append $admins | sort
        let text = if ($file | str ends-with ".json") { $plain | to json } else { $plain }
        if ($path | path exists) and (recipients-of $path) == $want {
            let current = decrypt $path
            let same = if $current == null { false } else if ($file | str ends-with ".json") {
                (try { canonical ($current | from json) | to json } catch { "" }) == (canonical $plain | to json)
            } else { $current == $text }
            if $same { return false }
        }
        print $"write   src/($file)"
        if $apply {
            mkdir ($path | path dirname)
            $text | secrets-encrypt $ROOT $path
        }
        true
    }
    let remove_file = {|file: string|
        let path = src-path $file
        if not ($path | path exists) { return false }
        print $"delete  src/($file)"
        if $apply { rm --force $path }
        true
    }
    mut changed = 0

    # the onion addresses follow their keys: the edge's rules and the owner read them, never the keys
    let onions = $found | items {|k, v| {k: $k, v: $v} }
        | where { $in.v != "" and (do $kind_of $in.k) =~ '^(guardsData:)?onion$' }
        | sort-by k | reduce --fold {} {|e, acc| $acc | insert $e.k (onion-address $e.v) }
    let onions_text = $"($onions | to json --indent 2)\n"
    let onions_path = src-path $ONIONS_FILE
    if not ($onions_path | path exists) or (open --raw $onions_path) != $onions_text {
        print $"write   src/($ONIONS_FILE)"
        $changed += 1
        if $apply {
            mkdir ($onions_path | path dirname)
            $onions_text | save --force $onions_path
        }
    }

    let sops_config_path = $ROOT | path join .sops.yaml
    if not ($sops_config_path | path exists) or (open --raw $sops_config_path) != $sops_config {
        print "write   .sops.yaml"
        $changed += 1
        if $apply { $sops_config | save --force $sops_config_path }
    }

    for c in $configs {
        let home = do $home_of $c
        if (do $write_file ($home | path join $SECRETS_KEY_NAME) $"($keys | get $c)\n") { $changed += 1 }
        let pub_file = src-path ($home | path join $SECRETS_PUB_NAME)
        let pub = if ($pub_file | path exists) { open --raw $pub_file | str trim } else { "" }
        if $pub != ($host_recipient | get $c) {
            print $"write   src/($home)/($SECRETS_PUB_NAME)"
            if $apply { $"($host_recipient | get $c)\n" | save --force $pub_file }
        }
    }

    # first every value in its new place beside its old copies, then the copies go: no failure point loses one
    if $apply {
        for file in ($new | columns | sort | where {|file| do $in_plan $file }) {
            let union = $old | get --optional $file | default {} | merge ($new | get $file)
            if (do $write_file $file $union) { $changed += 1 }
        }
    }
    for c in $configs {
        let shared = (do $home_of $c) | path join $SECRETS_SHARED_NAME
        if (do $in_plan $shared) and (do $write_file $shared (do $shared_plain $c)) { $changed += 1 }
    }
    for file in ($new | columns | sort) {
        let values = $new | get $file
        let wrote = if ($values | is-empty) and not (do $in_plan $file) { do $remove_file $file } else { do $write_file $file $values }
        if $wrote { $changed += 1 }
    }

    # keys and shared copies of hosts that are gone, or that read no shared secret any more
    let homes_files = [$SECRETS_KEY_NAME $SECRETS_SHARED_NAME] | each {|name|
        $SECRETS_HOME_DIRS | each {|dir| glob (src-path $dir | path join "*" $name) } | flatten | sort
    } | flatten | each { path relative-to $SRC }
    for file in ($homes_files | where { not (do $in_plan $in) }) {
        if (do $remove_file $file) { $changed += 1 }
        if ($file | path basename) == $SECRETS_KEY_NAME and (do $remove_file ($file | path dirname | path join $SECRETS_PUB_NAME)) { $changed += 1 }
    }
    let nodes = src-path generated/nodes
    if $apply and ($nodes | path exists) {
        ls $nodes | where type == dir | where { ls $in.name | is-empty } | each { rm $in.name } | ignore
    }

    if $host_keys_out != null and $apply {
        ^install -m 600 /dev/null $host_keys_out
        $keys | to json | save --append $host_keys_out
    }

    if not $apply and $changed > 0 {
        print $"dry run: ($changed) file\(s\) would change. Re-run with --apply to write \(add --prune to delete unused values\)."
    } else {
        print $">>> Secrets: ($configs | length) hosts, ($changed) file\(s\) changed."
    }
}
