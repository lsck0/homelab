# the router's onion services: every route whose `onion` is on (modules/service.nix), published by its tor and handed
# to the edge, which serves the address with the route's chain (modules/traefik)
#
# A route's key is the router's secret <route>-onion-key (kind onion: an ed25519 seed, generated by secrets-sync.sh,
# which writes its address to src/generated/onions.json), turned into tor's key file before every start
# (scripts/lib/onion.sh). Tor derives the address from that file, so the edge's rule and the published service name
# one address. Rejected: a key tor generates on first start, which lives on the router's disk alone (losing it loses
# the address) and is unknown when the edge's rules are evaluated.
{ config, lib, pkgs, inventory, site, catalog, ... }:
let
  net = import ../../../modules/net.nix { inherit lib inventory site; };
  service = import ../../../modules/service.nix { inherit lib; };
  torPorts = import ../../../modules/tor-ports.nix;

  onionRoutes = lib.filterAttrs (_: r: r.onion) catalog.external;
  keyDir = "/run/tor-onion-keys";
  # what a visitor's browser asks for: http, the onion service being the encryption
  virtualPort = net.ports.http;
in {
  services.tor.relay.onionServices = lib.mapAttrs (name: _: {
    version = 3;
    map = [ { port = virtualPort; target = { addr = net.ipOf net.zones.external.ingress; port = torPorts.onionIngress; }; } ];
    secretKey = "${keyDir}/${name}";
  }) onionRoutes;

  sops.secrets = lib.mapAttrs' (name: _: lib.nameValuePair (service.onionKeyOf name) { restartUnits = [ "tor.service" ]; }) onionRoutes;

  systemd.services.tor-onion-keys = lib.mkIf (onionRoutes != { }) {
    description = "Turn the onion routes' seeds into tor's key files";
    before = [ "tor.service" ];
    requiredBy = [ "tor.service" ];
    partOf = [ "tor.service" ];
    path = [ pkgs.openssl pkgs.coreutils ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      RuntimeDirectory = baseNameOf keyDir;
      RuntimeDirectoryMode = "0700";
      UMask = "0077";
    };
    script = ''
      set -euo pipefail
      . ${../../../scripts/lib/onion.sh}
    '' + lib.concatMapStrings (name: ''
      onion_secret_key "$(cat ${config.sops.secrets.${service.onionKeyOf name}.path})" > ${keyDir}/${name}
    '') (lib.attrNames onionRoutes);
  };
}
