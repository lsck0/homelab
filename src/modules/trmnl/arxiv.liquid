{%- comment -%} daily arxiv math; kept flat, do not reindent {%- endcomment -%}

<style>
/* undo trmnl's centring wrapper; the framework sets the height above the title bar */
.layout { display: block !important; width: 100% !important; padding: 0 !important; margin: 0 !important; container-type: size; }
/* --u: 1px on the 780x420 og layout, the smaller ratio on bigger panels */
.ax { --u: min(calc(100cqw / 780), calc(100cqh / 420)); display: flex; flex-direction: column; height: 100%; width: 100%; gap: calc(6 * var(--u)); padding: calc(4 * var(--u)) calc(8 * var(--u)) 0; box-sizing: border-box; font-family: "Inter Variable", Inter, sans-serif; color: #000; }

/* ---- head: count, then the subjects as tiles ---------------------------- */
.ax-head { display: flex; align-items: stretch; gap: calc(6 * var(--u)); flex: 0 0 auto; }
.ax-count { flex: 0 0 auto; background: #000; color: #fff; border-radius: calc(4 * var(--u)); padding: calc(2 * var(--u)) calc(12 * var(--u)); display: flex; flex-direction: column; justify-content: center; }
.ax-count b { font-size: calc(30 * var(--u)); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
.ax-count span { font-size: calc(11 * var(--u)); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
.ax-subj { flex: 1 1 0; min-width: 0; border: calc(2 * var(--u)) solid #000; border-radius: calc(4 * var(--u)); padding: calc(3 * var(--u)) calc(7 * var(--u)); display: flex; flex-direction: column; justify-content: center; }
.ax-subj b { font-size: calc(20 * var(--u)); font-weight: 800; line-height: 1.05; font-variant-numeric: tabular-nums; }
.ax-subj span { font-size: calc(11 * var(--u)); font-weight: 700; line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---- papers: two columns, two title lines each ------------------------- */
.ax-list { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-flow: column; grid-template-rows: repeat(6, 1fr); column-gap: calc(16 * var(--u)); }
.ax-p { min-width: 0; min-height: 0; overflow: hidden; border-top: calc(1.5 * var(--u)) solid #000; padding: calc(3 * var(--u)) 0 calc(2 * var(--u)); display: flex; flex-direction: column; }
.ax-t { font-size: calc(14.5 * var(--u)); font-weight: 700; line-height: 1.18; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
.ax-m { display: flex; justify-content: space-between; align-items: baseline; gap: calc(8 * var(--u)); font-size: calc(11.5 * var(--u)); line-height: 1.2; margin-top: auto; padding-top: calc(1 * var(--u)); }
.ax-a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.ax-s { font-weight: 800; font-size: calc(10 * var(--u)); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; flex: 0 0 auto; border: calc(1.5 * var(--u)) solid #000; border-radius: calc(3 * var(--u)); padding: 0 calc(4 * var(--u)); }
.ax-empty { grid-column: 1 / -1; font-size: calc(18 * var(--u)); font-weight: 700; padding-top: calc(20 * var(--u)); }
</style>

{% if view == 'arxiv' %}
<div class="layout">
<div class="ax">

<div class="ax-head">
<div class="ax-count"><b>{{ total }}</b><span>new today</span></div>
{% for s in subjects %}
<div class="ax-subj"><b>{{ s.count }}</b><span>{{ s.name }}</span></div>
{% endfor %}
</div>

<div class="ax-list">
{% for p in papers %}
<div class="ax-p">
<div class="ax-t">{{ p.title }}</div>
<div class="ax-m"><span class="ax-a">{{ p.authors }}</span><span class="ax-s">{{ p.code }}</span></div>
</div>
{% endfor %}
{% if total == 0 %}<div class="ax-empty">Nothing announced. arXiv does not announce at weekends.</div>{% endif %}
</div>

</div>
</div>
<div class="title_bar">
<span class="title">arXiv math</span>
<span class="instance">{{ label }}{% unless is_today %} (last announcement){% endunless %}{% if more > 0 %} &middot; +{{ more }} more{% endif %}</span>
</div>

{% else %}
<div class="layout">
<div class="markdown">
<span class="title">arXiv: no data</span>
<div class="content">No `view` in the payload. Check the plugin's Polling URL points at arxiv.json on terminal.lsck0.dev.</div>
</div>
</div>
<div class="title_bar"><span class="title">arXiv math</span><span class="instance">waiting for data</span></div>
{% endif %}
