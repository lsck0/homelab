{%- comment -%} house energy, data from energy-sync.py; german labels; keep flat {%- endcomment -%}

<style>
/* undo trmnl's centring wrapper */
.layout { display: block !important; width: 100% !important; height: 100% !important; padding: 0 !important; margin: 0 !important; }
/* fill the panel height, not the og 452px, so the trmnl x is not left half blank */
.en { display: flex; flex-direction: column; height: 100%; width: 100%; gap: 5px; padding: 8px 10px 4px; box-sizing: border-box; }

/* ---- now --------------------------------------------------------------- */
.en-top { display: flex; gap: 6px; flex: 0 0 auto; }
.en-stat { flex: 1 1 0; border: 2px solid #000; padding: 2px 7px; min-width: 0; }
.en-stat--dark { background: #000; }
.en-stat--dark .en-k, .en-stat--dark .en-v, .en-stat--dark .en-sub { color: #fff; }
.en-k { font-size: 12px; font-weight: 700; letter-spacing: .10em; text-transform: uppercase; }
.en-v { font-size: 22px; font-weight: 700; line-height: 1.05; font-variant-numeric: tabular-nums; white-space: nowrap; }
.en-sub { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.en-soc { height: 4px; background: #d2d2d2; margin-top: 2px; }
.en-soc span { display: block; height: 100%; background: #000; }

/* ---- middle ------------------------------------------------------------ */
.en-mid { display: flex; gap: 6px; flex: 1 1 auto; min-height: 0; }
.en-panel { border: 2px solid #000; padding: 3px 7px; min-width: 0; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
.en-h { font-size: 12px; font-weight: 700; letter-spacing: .10em; text-transform: uppercase; border-bottom: 1px solid #000; margin-bottom: 2px; display: flex; justify-content: space-between; gap: 6px; white-space: nowrap; }
.en-h i { font-style: normal; font-weight: 400; letter-spacing: 0; text-transform: none; }
.en-day { flex: 1 1 auto; }
.en-chart { flex: 1 1 auto; min-height: 0; position: relative; }
.en-chart svg { display: block; width: 100%; height: 100%; }
.en-axis { display: flex; justify-content: space-between; font-size: 10px; line-height: 1; padding-top: 1px; }
.en-legend { display: flex; gap: 10px; font-size: 10px; line-height: 1.2; }
.en-legend b { display: inline-block; width: 10px; height: 8px; margin-right: 3px; vertical-align: -1px; }
.en-side { flex: 0 0 236px; display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.en-line { display: flex; justify-content: space-between; gap: 6px; font-size: 13px; line-height: 1.3; }
.en-line b { font-variant-numeric: tabular-nums; }
.en-line--big { font-size: 16px; font-weight: 700; }

/* ---- spot strip -------------------------------------------------------- */
.en-spot { flex: 0 0 auto; margin-top: 3px; }
.en-bars { display: flex; align-items: flex-end; gap: 2px; height: 26px; }
.en-bars span { flex: 1 1 0; background: #bdbdbd; min-height: 2px; }
.en-bars span.cheap { background: #000; }
.en-spot-meta { display: flex; justify-content: space-between; font-size: 10px; line-height: 1.2; }
/* strip starts now, not at midnight: own hour labels */
.en-spot-hours { display: flex; gap: 2px; font-size: 9px; line-height: 1.1; }
.en-spot-hours span { flex: 1 1 0; white-space: nowrap; overflow: visible; }

/* ---- bottom ------------------------------------------------------------ */
.en-bot { display: flex; gap: 6px; flex: 0 0 104px; min-height: 0; }
.en-hist { flex: 1 1 auto; }
.en-cols { flex: 1 1 auto; display: flex; gap: 4px; align-items: flex-end; min-height: 0; }
.en-col { flex: 1 1 0; display: flex; flex-direction: column; align-items: stretch; height: 100%; min-width: 0; }
.en-col-bars { flex: 1 1 auto; display: flex; gap: 1px; align-items: flex-end; }
.en-col-bars span { flex: 1 1 0; min-height: 1px; }
.en-col-bars .pv { background: #bdbdbd; }
.en-col-bars .load { background: #000; }
.en-col-l { font-size: 9px; line-height: 1.1; text-align: center; }
.en-meter { flex: 0 0 178px; }
.en-meter--stale .en-h { background: #000; color: #fff; padding: 0 3px; }

/* ---- footer ------------------------------------------------------------ */
.en-foot { flex: 0 0 auto; display: flex; justify-content: space-between; gap: 10px; font-size: 11px; line-height: 1.3; }
.en-foot b { font-weight: 700; letter-spacing: .10em; text-transform: uppercase; }
.en-foot em { font-style: normal; font-weight: 700; }
</style>

{% if view == 'energy' %}
<div class="layout">
<div class="en">

<div class="en-top">
<div class="en-stat">
<div class="en-k">PV</div>
<div class="en-v">{{ now.pv }}</div>
<div class="en-sub">heute {{ today.pv }} kWh</div>
</div>
<div class="en-stat">
<div class="en-k">Verbrauch</div>
<div class="en-v">{{ now.load }}</div>
<div class="en-sub">heute {{ today.load }} kWh</div>
</div>
<div class="en-stat{% if now.grid_label == 'Netzbezug' %} en-stat--dark{% endif %}">
<div class="en-k">{{ now.grid_label }}</div>
<div class="en-v">{{ now.grid }}</div>
<div class="en-sub">Autarkie heute {{ today.autarky }}</div>
</div>
<div class="en-stat">
<div class="en-k">Batterie {{ now.soc }}</div>
<div class="en-v">{{ now.battery }}</div>
<div class="en-soc"><span style="width:{{ now.soc_pct }}%"></span></div>
<div class="en-sub">{{ now.battery_label }}</div>
</div>
<div class="en-stat">
<div class="en-k">Börse</div>
<div class="en-v">{{ spot.now }} ct</div>
<div class="en-sub">pro kWh, ohne Abgaben</div>
</div>
</div>

<div class="en-mid">
<div class="en-panel en-day">
<div class="en-h"><span>Heute</span><i>bis {{ chart.top }}</i></div>
<div class="en-chart">
<svg viewBox="0 0 480 120" preserveAspectRatio="none">
<line x1="120" y1="0" x2="120" y2="120" stroke="#d2d2d2" stroke-width="1"/>
<line x1="240" y1="0" x2="240" y2="120" stroke="#d2d2d2" stroke-width="1"/>
<line x1="360" y1="0" x2="360" y2="120" stroke="#d2d2d2" stroke-width="1"/>
<path d="{{ chart.pv }}" fill="#bdbdbd" stroke="none"/>
<path d="{{ chart.soc }}" fill="none" stroke="#000" stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"/>
<path d="{{ chart.load }}" fill="none" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>
<line x1="{{ chart.now_x }}" y1="0" x2="{{ chart.now_x }}" y2="120" stroke="#000" stroke-width="1" vector-effect="non-scaling-stroke"/>
</svg>
</div>
<div class="en-axis"><span>0</span><span>6</span><span>12</span><span>18</span><span>24 Uhr</span></div>
<div class="en-legend"><span><b style="background:#bdbdbd"></b>PV</span><span><b style="background:#000"></b>Verbrauch</span><span><b style="border-top:1px dashed #000;height:0"></b>Batterie</span></div>
<div class="en-spot">
<div class="en-bars">{% for h in spot.hours %}<span{% if h.cheap %} class="cheap"{% endif %} style="height:{{ h.pct }}%"></span>{% endfor %}</div>
<div class="en-spot-hours">{% for h in spot.hours %}<span>{% if h.label %}{{ h.h }}{% endif %}</span>{% endfor %}</div>
<div class="en-spot-meta"><span>Börse 24h: {{ spot.lo }} bis {{ spot.hi }} ct</span><span>günstig: {{ spot.cheap }}</span></div>
</div>
</div>

<div class="en-side">
<div class="en-panel">
<div class="en-h"><span>Energie heute</span></div>
<div class="en-line"><span>Erzeugt</span><b>{{ today.pv }} kWh</b></div>
<div class="en-line"><span>Verbraucht</span><b>{{ today.load }} kWh</b></div>
<div class="en-line"><span>Netzbezug</span><b>{{ today.import }} kWh</b></div>
<div class="en-line"><span>Einspeisung</span><b>{{ today.export }} kWh</b></div>
<div class="en-line"><span>Eigenverbrauchsquote</span><b>{{ today.self_use }}</b></div>
</div>
<div class="en-panel">
<div class="en-h"><span>Kosten</span><i>€</i></div>
<div class="en-line en-line--big"><span>Heute</span><b>{{ today.cost }}</b></div>
<div class="en-line"><span>PV gespart heute</span><b>{{ today.saved }}</b></div>
<div class="en-line"><span>Prognose Monat</span><b>{{ forecast.month }}</b></div>
<div class="en-line"><span>Prognose Jahr</span><b>{{ forecast.year }}</b></div>
</div>
</div>
</div>

<div class="en-bot">
<div class="en-panel en-hist">
<div class="en-h"><span>14 Tage</span><i>PV grau, Verbrauch schwarz, bis {{ history.top }} kWh</i></div>
<div class="en-cols">
{% for d in history.days %}
<div class="en-col">
<div class="en-col-bars"><span class="pv" style="height:{{ d.pv_pct }}%"></span><span class="load" style="height:{{ d.load_pct }}%"></span></div>
<div class="en-col-l">{{ d.label }}</div>
</div>
{% endfor %}
</div>
</div>
<div class="en-panel en-meter{% if gas.stale %} en-meter--stale{% endif %}">
<div class="en-h"><span>Gas</span><i>{{ gas.age }}</i></div>
<div class="en-line"><span>Stand</span><b>{{ gas.reading }} m³</b></div>
<div class="en-line"><span>7 Tage</span><b>{{ gas.week }} m³</b></div>
<div class="en-line"><span>Kosten 7 Tage</span><b>{{ gas.week_cost }} €</b></div>
</div>
<div class="en-panel en-meter{% if water.stale %} en-meter--stale{% endif %}">
<div class="en-h"><span>Wasser</span><i>{{ water.age }}</i></div>
<div class="en-line"><span>Stand</span><b>{{ water.reading }} m³</b></div>
<div class="en-line"><span>7 Tage</span><b>{{ water.week }} m³</b></div>
<div class="en-line"><span>Kosten 7 Tage</span><b>{{ water.week_cost }} €</b></div>
</div>
</div>

<div class="en-foot">
<span><b>Energie</b> &middot; {{ label }}</span>
<span>{% unless now.online %}<em>Wechselrichter nicht erreichbar</em> {% endunless %}{% if prices_missing > 0 %}<em>{{ prices_missing }} Preise fehlen</em>{% endif %}</span>
</div>

</div>
</div>

{% else %}
<div class="layout">
<div class="markdown">
<span class="title">Energie: keine Daten</span>
<div class="content">Kein `view` in den Daten. Die Polling-URL des Plugins muss auf energy.json auf terminal.lsck0.dev zeigen.</div>
</div>
</div>
<div class="title_bar"><span class="title">Energie</span><span class="instance">warte auf Daten</span></div>
{% endif %}
