{%- comment -%}
GitHub for the TRMNL terminal. One polling URL:

  https://terminal.lsck0.dev/<token>/github.json

Everything is precomputed by src/scripts/github-sync.py. Liquid cannot do
arithmetic worth relying on, so ages and counts arrive ready to render.

Monochrome e-ink, 800x480. State is carried by shape, not colour: a filled
square is healthy, a hollow one is not.

Weighted by what the account actually holds. Measured 2026-09-24: 0 open
issues, 0 open PRs, and 49 failed CI runs that group into 2 repos. So the repo
list gets the wide column in two sub-columns, and the rest are short lists that
say so when empty.

Kept flat, one tag per line. Do not run "Fix indentation" on it.
{%- endcomment -%}

<style>
.layout { display: block !important; width: 100% !important; height: 100% !important; padding: 0 !important; margin: 0 !important; }
/* 452px for the same reason as terminal.liquid: TRMNL's container has no
   definite height, so height:100% collapses and children run off the bottom.
   800x480 less the 18px content offset and a 10px margin. */
.gh { display: flex; flex-direction: column; height: 452px; max-height: 452px; width: 100%; gap: 5px; padding: 8px 10px 4px; box-sizing: border-box; }

/* ---- headline numbers ------------------------------------------------- */
.gh-top { display: flex; gap: 6px; flex: 0 0 auto; }
.gh-stat { flex: 1 1 0; border: 2px solid #000; padding: 2px 7px; min-width: 0; }
.gh-stat--bad { background: #000; }
.gh-stat--bad .gh-k, .gh-stat--bad .gh-v, .gh-stat--bad .gh-sub { color: #fff; }
.gh-k { font-size: 12px; font-weight: 700; letter-spacing: .10em; text-transform: uppercase; }
.gh-v { font-size: 25px; font-weight: 700; line-height: 1.05; font-variant-numeric: tabular-nums; }
.gh-sub { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---- body: repos wide, CI and work narrow ------------------------------ */
.gh-mid { display: flex; gap: 6px; flex: 1 1 auto; min-height: 0; }
.gh-box { border: 2px solid #000; padding: 3px 7px; display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
/* The repo list is the only one with real volume - 32 of them against a
   handful of failing workflows - so it takes the wide column. Sizing CI wide
   because it had 49 notifications was wrong: they collapse to 2 repos, and
   the box rendered two rows above 300px of nothing. */
.gh-repos { flex: 1.25 1 0; }
.gh-side { flex: 1 1 0; display: flex; flex-direction: column; gap: 5px; min-width: 0; min-height: 0; }
.gh-ci { flex: 0 0 auto; max-height: 176px; }
.gh-work { flex: 0 0 auto; max-height: 116px; }
/* Languages fill what open issues and PRs do not. Counted off the repo list,
   so it costs no extra API call. */
.gh-lang { flex: 1 1 0; }
.gh-bar { flex: 0 0 46px; height: 5px; background: #d2d2d2; }
.gh-bar span { display: block; height: 100%; background: #000; }
/* two columns inside the wide box: 16 repos read better than 9 and a gap */
.gh-cols { display: flex; gap: 12px; min-height: 0; overflow: hidden; }
.gh-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }

.gh-h { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid #000; margin-bottom: 1px; display: flex; justify-content: space-between; gap: 6px; white-space: nowrap; flex: 0 0 auto; }
.gh-h i { font-style: normal; font-weight: 400; color: #555; }

.gh-l { display: flex; align-items: center; gap: 5px; font-size: 13px; line-height: 1.42; flex: 0 0 auto; min-width: 0; }
.gh-dot { width: 8px; height: 8px; flex: 0 0 auto; border: 1px solid #000; background: #fff; }
.gh-dot--ok { background: #000; }
.gh-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gh-meta { flex: 0 0 auto; color: #555; font-size: 11px; font-variant-numeric: tabular-nums; }
.gh-n { flex: 0 0 auto; font-weight: 700; font-variant-numeric: tabular-nums; }

/* An empty list is the normal state for issues and PRs here. Saying so beats
   a blank box, which reads as a feed that has broken. */
.gh-none { font-size: 12px; color: #555; padding: 3px 0; }

.gh-foot { flex: 0 0 16px; display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #555; white-space: nowrap; }
</style>

<div class="gh">

  <div class="gh-top">
    <div class="gh-stat">
      <div class="gh-k">Commits 7d</div>
      <div class="gh-v">{{ commits7 }}</div>
      <div class="gh-sub">{{ commits30 }} in 30d</div>
    </div>
    <div class="gh-stat">
      <div class="gh-k">Repos</div>
      <div class="gh-v">{{ repos }}</div>
      <div class="gh-sub">{{ stars }} stars</div>
    </div>
    <div class="gh-stat{% if ci_failing > 0 %} gh-stat--bad{% endif %}">
      <div class="gh-k">CI failing</div>
      <div class="gh-v">{{ ci_failing }}</div>
      <div class="gh-sub">{{ ci_runs }} runs</div>
    </div>
    <div class="gh-stat">
      <div class="gh-k">Open</div>
      <div class="gh-v">{{ issues }}/{{ prs }}</div>
      <div class="gh-sub">issues / PRs</div>
    </div>
    <div class="gh-stat{% if alerts > 0 %} gh-stat--bad{% endif %}">
      <div class="gh-k">Alerts</div>
      <div class="gh-v">{{ alerts }}</div>
      <div class="gh-sub">security</div>
    </div>
  </div>

  <div class="gh-mid">

    <div class="gh-box gh-repos">
      <div class="gh-h"><span>Recently pushed</span><i>lang / stars / ago</i></div>
      <div class="gh-cols">
        <div class="gh-col">
        {%- for r in active_a %}
        <div class="gh-l">
          <span class="gh-name">{{ r.name }}</span>
          <span class="gh-meta">{{ r.lang }}</span>
          {%- if r.stars > 0 %}
          <span class="gh-n">{{ r.stars }}</span>
          {%- endif %}
          <span class="gh-meta">{{ r.age }}</span>
        </div>
        {%- endfor %}
        </div>
        <div class="gh-col">
        {%- for r in active_b %}
        <div class="gh-l">
          <span class="gh-name">{{ r.name }}</span>
          <span class="gh-meta">{{ r.lang }}</span>
          {%- if r.stars > 0 %}
          <span class="gh-n">{{ r.stars }}</span>
          {%- endif %}
          <span class="gh-meta">{{ r.age }}</span>
        </div>
        {%- endfor %}
        </div>
      </div>
    </div>

    <div class="gh-side">
    <div class="gh-box gh-ci">
      <div class="gh-h"><span>Failing CI</span><i>runs / last</i></div>
      {%- if ci_failing == 0 %}
      <div class="gh-none">every workflow green</div>
      {%- endif %}
      {%- for c in ci %}
      <div class="gh-l">
        <span class="gh-dot"></span>
        <span class="gh-name">{{ c.name }}</span>
        <span class="gh-meta">{{ c.what }}</span>
        <span class="gh-n">{{ c.n }}</span>
        <span class="gh-meta">{{ c.age }}</span>
      </div>
      {%- endfor %}
    </div>


      <div class="gh-box gh-work">
        <div class="gh-h"><span>Issues &amp; PRs</span><i>open</i></div>
        {%- if work_empty %}
        <div class="gh-none">nothing open</div>
        {%- endif %}
        {%- for w in work %}
        <div class="gh-l">
          <span class="gh-dot{% if w.kind == 'pr' %} gh-dot--ok{% endif %}"></span>
          <span class="gh-name">{{ w.title }}</span>
          <span class="gh-meta">{{ w.repo }}</span>
          <span class="gh-meta">{{ w.age }}</span>
        </div>
        {%- endfor %}
      </div>

      <div class="gh-box gh-lang">
        <div class="gh-h"><span>Languages</span><i>repos</i></div>
        {%- for l in langs %}
        <div class="gh-l">
          <span class="gh-name">{{ l.name }}</span>
          <span class="gh-bar"><span style="width:{{ l.pct }}%"></span></span>
          <span class="gh-n">{{ l.n }}</span>
        </div>
        {%- endfor %}
      </div>

    </div>
  </div>

  <div class="gh-foot">
    <span>github.com/{{ user }}</span>
    <span>filled = PR, hollow = issue</span>
    <span>{{ generated }}</span>
  </div>

</div>
