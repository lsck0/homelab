{%- comment -%} homelab status, data from stats-sync.py; keep flat {%- endcomment -%}

<style>
/* undo trmnl's centring wrapper; the framework keeps the height, and it is the size container */
.layout { display: block !important; width: 100% !important; padding: 0 !important; margin: 0 !important; container-type: size; }
/* --u: 1px on the 780x460 og layout, the smaller ratio on bigger panels so nothing overflows */
.hl { --u: min(calc(100cqw / 780), calc(100cqh / 460)); display: flex; flex-direction: column; height: 100%; width: 100%; gap: calc(5 * var(--u)); padding: calc(6 * var(--u)) calc(8 * var(--u)) calc(2 * var(--u)); box-sizing: border-box; font-family: "Inter Variable", Inter, sans-serif; color: #000; }
.hl b { font-weight: 700; }

/* ---- headline numbers ------------------------------------------------- */
.hl-top { display: flex; gap: calc(6 * var(--u)); flex: 0 0 auto; }
.hl-stat { flex: 1 1 0; border: calc(2 * var(--u)) solid #000; border-radius: calc(4 * var(--u)); padding: calc(3 * var(--u)) calc(8 * var(--u)) calc(4 * var(--u)); min-width: 0; }
.hl-stat--bad { background: #000; color: #fff; }
.hl-k { font-size: calc(11 * var(--u)); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hl-v { font-size: calc(28 * var(--u)); font-weight: 800; line-height: 1.05; font-variant-numeric: tabular-nums; white-space: nowrap; }
/* two rates share one tile: stacked, same height as one big number */
.hl-v--pair { font-size: calc(14 * var(--u)); line-height: 1.05; }
.hl-sub { font-size: calc(12 * var(--u)); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---- services --------------------------------------------------------- */
.hl-svc { flex: 0 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: calc(1 * var(--u)) calc(12 * var(--u)); border: calc(2 * var(--u)) solid #000; border-radius: calc(4 * var(--u)); padding: calc(4 * var(--u)) calc(8 * var(--u)); }
.hl-row { display: flex; align-items: center; gap: calc(5 * var(--u)); font-size: calc(13 * var(--u)); font-weight: 500; line-height: 1.3; min-width: 0; }
.hl-dot { width: calc(8 * var(--u)); height: calc(8 * var(--u)); flex: 0 0 auto; border: calc(1.5 * var(--u)) solid #000; border-radius: 50%; background: #000; }
.hl-dot--off { background: #fff; }
.hl-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* cpu over mem, read as load without numbers */
.hl-bars { flex: 0 0 calc(26 * var(--u)); display: flex; flex-direction: column; gap: calc(2 * var(--u)); }
.hl-bar { height: calc(4 * var(--u)); border: calc(1 * var(--u)) solid #000; box-sizing: border-box; }
.hl-bar span { display: block; height: 100%; background: #000; }

/* ---- bottom: traffic + side panels ------------------------------------- */
.hl-mid { display: flex; gap: calc(6 * var(--u)); flex: 1 1 auto; min-height: 0; }
.hl-box { border: calc(2 * var(--u)) solid #000; border-radius: calc(4 * var(--u)); padding: calc(3 * var(--u)) calc(8 * var(--u)); min-width: 0; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
.hl-h { font-size: calc(11 * var(--u)); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; border-bottom: calc(2 * var(--u)) solid #000; margin-bottom: calc(2 * var(--u)); padding-bottom: calc(1 * var(--u)); display: flex; justify-content: space-between; gap: calc(6 * var(--u)); white-space: nowrap; flex: 0 0 auto; }
.hl-h i { font-style: normal; font-weight: 500; letter-spacing: 0; text-transform: none; }

/* from traefik logs via loki; rows cut to fit */
.hl-who { flex: 1 1 auto; flex-direction: row; gap: calc(12 * var(--u)); }
.hl-who-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
/* a bar under the row, not a fill behind it: 1-bit dither eats text */
.hl-who-l { display: flex; justify-content: space-between; gap: calc(6 * var(--u)); font-size: calc(12.5 * var(--u)); line-height: 1.12; flex: 0 0 auto; }
.hl-who-l span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.hl-who-l b { flex: 0 0 auto; font-variant-numeric: tabular-nums; }
.hl-who-bar { height: calc(1.5 * var(--u)); min-width: calc(1 * var(--u)); background: #000; margin-bottom: calc(1.5 * var(--u)); flex: 0 0 auto; }
/* int = lan/mesh, ext = internet, + = both */
.hl-who-l em { font-style: normal; font-size: calc(9 * var(--u)); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }

.hl-side { flex: 0 0 calc(214 * var(--u)); min-width: 0; display: flex; flex-direction: column; gap: calc(5 * var(--u)); min-height: 0; }
.hl-box--grow { flex: 1 1 auto; }
.hl-line { display: flex; justify-content: space-between; gap: calc(6 * var(--u)); font-size: calc(13 * var(--u)); font-weight: 500; line-height: 1.35; }
.hl-line b { font-variant-numeric: tabular-nums; }
.hl-t { font-size: calc(12 * var(--u)); line-height: 1.2; margin-top: calc(2 * var(--u)); min-width: 0; overflow: hidden; }
.hl-t-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
.hl-t-meta { display: flex; justify-content: space-between; font-size: calc(11 * var(--u)); }
.hl-prog { height: calc(5 * var(--u)); border: calc(1 * var(--u)) solid #000; box-sizing: border-box; margin-top: calc(1 * var(--u)); }
.hl-prog span { display: block; height: 100%; background: #000; }
.hl-empty { font-size: calc(12 * var(--u)); }

/* ---- footer: own line, title_bar costs 40px ------------------------------ */
.hl-foot { flex: 0 0 auto; display: flex; justify-content: space-between; gap: calc(10 * var(--u)); font-size: calc(11 * var(--u)); line-height: 1.25; }
.hl-foot b { letter-spacing: .08em; text-transform: uppercase; }
.hl-foot span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.hl-foot em { font-style: normal; font-weight: 800; }
</style>

{% if view == 'stats' %}
<div class="layout">
<div class="hl">

<div class="hl-top">
<div class="hl-stat{% if summary.down.size > 0 %} hl-stat--bad{% endif %}">
<div class="hl-k">Services</div>
<div class="hl-v">{{ summary.up }}/{{ summary.total }}</div>
<div class="hl-sub">{% if summary.down.size > 0 %}down: {{ summary.down | join: ", " }}{% else %}{{ summary.off }} switched off{% endif %}</div>
</div>
<div class="hl-stat">
<div class="hl-k">CPU &middot; {{ totals.cores }} cores</div>
<div class="hl-v">{{ totals.cpu_pct }}%</div>
<div class="hl-sub">{% if summary.busiest %}{{ summary.busiest.name }} {{ summary.busiest.cpu_pct }}%{% endif %}</div>
</div>
<div class="hl-stat">
<div class="hl-k">Memory &middot; {{ totals.mem_total }}</div>
<div class="hl-v">{{ totals.mem_pct }}%</div>
<div class="hl-sub">{{ totals.mem_used }} used</div>
</div>
<div class="hl-stat">
<div class="hl-k">Network</div>
<div class="hl-v hl-v--pair">&darr; {{ network.rx }}<br>&uarr; {{ network.tx }}</div>
<div class="hl-sub">{% if network.top.size > 0 %}{{ network.top[0].vm }} {{ network.top[0].rate }}{% endif %}</div>
</div>
<div class="hl-stat">
<div class="hl-k">Torrents</div>
<div class="hl-v">{{ torrents.downloading }}/{{ torrents.total }}</div>
<div class="hl-sub">{{ torrents.seeding }} seeding &middot; {{ torrents.paused }} paused</div>
</div>
</div>

<div class="hl-svc">
{% for s in services %}
<div class="hl-row">
<span class="hl-dot{% unless s.online %} hl-dot--off{% endunless %}"></span>
<span class="hl-name">{{ s.name }}</span>
<span class="hl-bars"><span class="hl-bar"><span style="width:{{ s.cpu_pct }}%"></span></span><span class="hl-bar"><span style="width:{{ s.mem_pct }}%"></span></span></span>
</div>
{% endfor %}
</div>

<div class="hl-mid">

<div class="hl-box hl-who">
{% if clients.available %}
<div class="hl-who-col">
<div class="hl-h"><span>From</span><i>{{ clients.window }}</i></div>
{% for c in clients.countries %}
<div class="hl-who-l"><span>{{ c.name }}</span><b>{{ c.count }}</b></div><div class="hl-who-bar" style="width:{{ c.pct }}%"></div>
{% endfor %}
</div>
<div class="hl-who-col">
<div class="hl-h"><span>Clients</span></div>
{% for a in clients.agents %}
<div class="hl-who-l"><span>{{ a.name }}</span><b>{{ a.count }}</b></div><div class="hl-who-bar" style="width:{{ a.pct }}%"></div>
{% endfor %}
</div>
<div class="hl-who-col">
<div class="hl-h"><span>Asking for</span></div>
{% for h in clients.hosts %}
<div class="hl-who-l"><span>{{ h.name }}</span><b>{{ h.count }}</b></div><div class="hl-who-bar" style="width:{{ h.pct }}%"></div>
{% endfor %}
</div>
<div class="hl-who-col">
<div class="hl-h"><span>How it went</span></div>
{% for t in clients.traffic %}
<div class="hl-who-l"><span>{{ t.name }}</span><b>{{ t.count }}</b></div><div class="hl-who-bar" style="width:{{ t.pct }}%"></div>
{% endfor %}
</div>
<div class="hl-who-col">
<div class="hl-h"><span>Routes</span><i>3h</i></div>
{% for r in requests %}
<div class="hl-who-l"><span>{{ r.name }} <em>{{ r.origin }}{% if r.mixed %}+{% endif %}</em></span><b>{{ r.rpm }}</b></div><div class="hl-who-bar" style="width:{{ r.pct }}%"></div>
{% endfor %}
{% if requests.size == 0 %}<div class="hl-who-l"><span>no traffic</span></div>{% endif %}
</div>
{% else %}
<div class="hl-who-col"><div class="hl-h"><span>Who is calling</span></div><div class="hl-who-l"><span>no access log in Loki</span></div></div>
{% endif %}
</div>

<div class="hl-side">
<div class="hl-box">
<div class="hl-h"><span>Disks</span><i>{{ storage.free_total }} free</i></div>
{% for d in storage.top %}
<div class="hl-line"><span>{{ d.vm }}{% unless d.mount == '/' %} {{ d.mount }}{% endunless %}</span><b>{{ d.pct }}%</b></div>
{% endfor %}
</div>

<div class="hl-box hl-box--grow">
<div class="hl-h"><span>Torrents</span><i>&darr;{{ torrents.dl }} &uarr;{{ torrents.ul }}</i></div>
{% if torrents.available %}
{% for t in torrents.items %}
<div class="hl-t">
<div class="hl-t-name">{{ t.name }}</div>
<div class="hl-prog"><span style="width:{{ t.pct }}%"></span></div>
<div class="hl-t-meta"><span>{{ t.pct }}% &middot; {{ t.size }}</span><span>{{ t.speed }}{% if t.eta != '' %} &middot; {{ t.eta }}{% endif %}</span></div>
</div>
{% endfor %}
{% if torrents.items.size == 0 %}<div class="hl-empty">nothing downloading &middot; {{ torrents.seeding }} seeding</div>{% endif %}
{% else %}
<div class="hl-empty">qBittorrent unreachable</div>
{% endif %}
</div>
</div>

</div>

<div class="hl-foot">
<span><b>Homelab</b> &middot; {{ label }}</span>
<span>{% if summary.down.size > 0 %}<em>down: {{ summary.down | join: ", " }}</em>{% endif %}{% if services_more > 0 %} &middot; +{{ services_more }} more{% endif %}</span>
</div>

</div>
</div>

{% else %}
<div class="layout">
<div class="markdown">
<span class="title">Homelab: no data</span>
<div class="content">No `view` in the payload. Check the plugin's Polling URL points at stats.json on terminal.lsck0.dev.</div>
</div>
</div>
<div class="title_bar"><span class="title">Homelab</span><span class="instance">waiting for data</span></div>
{% endif %}
