# terraform's state: the nas holds it (/srv/nas/terraform), sync.sh pulls this working copy; it holds secrets
terraform.tfstate
# terraform's own backups, one per apply and per `state mv`
terraform.tfstate.backup
# the hash of the nas state the working copy last agreed with (src/scripts/lib/tfstate.sh)
terraform.tfstate.synced
*.tfstate.*.backup

__pycache__/
*.pyc
.hypothesis/
