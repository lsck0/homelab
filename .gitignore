# Terraform
.terraform/
**/.terraform/
*.tfvars

# Nix
result
result-*

# key material and certificates stay local (the repo's own; src/secrets/ is the encrypted lab secrets)
/secrets/

# OS
.DS_Store
.env
.direnv/

# Test/build artifacts
images/
*.iso
*.img
*.qcow2
*.sock
*.tfvars.json

# terraform's state holds secrets: the nas holds it and sync.nu's copy lives in ~/.local/state/homelab/terraform, so a
# stray one in the tree never reaches git
terraform.tfstate
# terraform's own backups, one per apply and per `state mv`
terraform.tfstate.backup
# the hash of the nas state a working copy last agreed with (src/scripts/lib/tfstate.nu)
terraform.tfstate.synced
*.tfstate.*.backup

__pycache__/
*.pyc
.hypothesis/
